  m_Script: {fileID: 11500000, guid: acb387dd07ed1425b96d82f3e0095f4e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DreamStudio.ForestStalker
  speed: 1.7
  glimpsedSpeedMultiplier: 0.5
  unwatchedSpeedMultiplier: 1.35
  catchDistance: 1.1
  dreadDistance: 9
  maxDistance: 22
  reappearDistance: 13
  startDelay: 10
  stareAngle: 14
  stareRange: 24
  stareToBanish: 5
  stareDecay: 2
  banishedMessage: 'You stand your ground and stare it down.

    The shadow trembles... and comes apart like smoke.

    It was only a dream.'
  caughtMessages:
  - 'It caught you...

    You wake up where you started.'
  - 'It caught you again...

    Running only seems to make it stronger.'
  - 'It caught you...

    It never moves while you are watching it.'
  eyeLight: {fileID: 2015550125}
  body: {fileID: 690281183}
  ground: {fileID: 697553565}
