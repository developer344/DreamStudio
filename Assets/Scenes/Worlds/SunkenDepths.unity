  m_Script: {fileID: 11500000, guid: 1e2984706fa1c4222a40f86490f36d69, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DreamStudio.NightmareWorld
  tokenName: Magic Shell
  introMessage: 'You are sinking in the Sunken Depths...

    You can''t breathe!

    Swim: pull your arms back, or push the stick where you look.

    Bubbles of air rise from the vents.'
  dreamMessage: 'The water is as easy to breathe as air.

    The sea is yours now.

    A portal home now waits where you started.'
  arrivedHomeMessage: Step through the portal to return to the Portal Room.
  revisitMessage: 'This dream is already restored.

    Wander as long as you like.

    The way home waits where you started.'
  spawnPoint: {fileID: 549515454}
  returnDistance: 5
  nightmareOnly:
  - {fileID: 1324282115}
  - {fileID: 1250287293}
  dreamOnly:
  - {fileID: 858766843}
  vision: {fileID: 1627599251}
  transitionDuration: 6
  onDreamRestored:
    m_PersistentCalls:
      m_Calls: []
