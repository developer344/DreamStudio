  m_Script: {fileID: 11500000, guid: 96246612c18824fe7b2dcc58d0263412, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DreamStudio.UnderwaterBreath
  maxAir: 75
  lowAirThreshold: 0.3
  drownDelay: 2.5
  bubbleFalloff: 0.9
  thoughtInterval: 100
  thoughts:
  - 'The fish drift past you, unhurried.

    Not one of them is reaching for air.'
  - 'Your chest should be burning by now...

    It isn''t.'
  - 'How long have you been down here?

    Long enough to have drowned.'
  - Why are you so afraid of the water?
  breakthroughMessage: 'You can''t hold on any longer... you breathe in.

    The water fills your lungs like air.

    You were dreaming all along.'
